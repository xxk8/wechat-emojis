{
  "name": "wechat-emojis",
  "version": "2.2.0",
  "description": "109 个微信内置表情 PNG（100×100）与类型安全的 TypeScript API，非官方整理",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./assets/*": "./assets/*",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "assets/**/*.png",
    "docs/API.md",
    "docs/NPM_USAGE.md",
    "docs/REACT_USAGE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "verify:assets": "node scripts/verify-assets.ts",
    "typecheck:examples": "tsc --noEmit --target es2017 --module commonjs --moduleResolution node --strict examples/typescript/example.ts",
    "test:unit": "node --test test/*.test.mts",
    "test": "npm run build && npm run typecheck:scripts && npm run typecheck:examples && npm run verify:assets && npm run check:package && npm run test:unit",
    "build:site": "node scripts/build-site.ts",
    "check:site": "node scripts/check-site.ts",
    "check:package": "node scripts/check-package.ts",
    "prepare": "node scripts/prepare.ts"
  },
  "keywords": [
    "wechat",
    "emoji",
    "emojis",
    "微信",
    "表情包",
    "typescript",
    "react",
    "vue",
    "angular"
  ],
  "author": "xxk8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxk8/wechat-emojis.git"
  },
  "bugs": {
    "url": "https://github.com/xxk8/wechat-emojis/issues"
  },
  "homepage": "https://xxk8.github.io/wechat-emojis/",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
