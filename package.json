{
  "name": "wechat-emojis",
  "version": "2.0.0",
  "description": "完整的微信内置表情资源库，包含 109 个高清 PNG 图片和类型安全的 TypeScript API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "assets/**/*",
    "docs/*.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "verify:assets": "node scripts/verify-assets.js",
    "typecheck:examples": "tsc --noEmit --target es2017 --module commonjs --moduleResolution node --strict examples/typescript/example.ts",
    "test": "npm run build && npm run typecheck:examples && npm run verify:assets",
    "prepare": "node scripts/prepare.js"
  },
  "keywords": [
    "wechat",
    "emoji",
    "emojis",
    "微信",
    "表情包",
    "typescript",
    "react",
    "vue",
    "angular"
  ],
  "author": "xxk8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxk8/wechat-emojis.git"
  },
  "bugs": {
    "url": "https://github.com/xxk8/wechat-emojis/issues"
  },
  "homepage": "https://github.com/xxk8/wechat-emojis#readme",
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
